{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "description": "starslingdev/skills pinned by commit in the chezmoi archive external",
      "customType": "regex",
      "matchStrings": [
        "url = \"https://github\\.com/(?<depName>starslingdev/skills)/archive/(?<currentDigest>[0-9a-f]{40})\\.tar\\.gz\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}",
      "currentValueTemplate": "main",
      "versioningTemplate": "git",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternal\\.toml$/"
      ]
    },
    {
      "description": "tmux and vim plugin archives pinned by commit, tracking master. Owners are listed explicitly; add a new owner here when a plugin from one is pinned",
      "customType": "regex",
      "matchStrings": [
        "url = \"https://github\\.com/(?<depName>(?:tmux-plugins|seebi|Shougo)/[^/\\s\"]+)/archive/(?<currentDigest>[0-9a-f]{40})\\.tar\\.gz\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}",
      "currentValueTemplate": "master",
      "versioningTemplate": "git",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternal\\.toml$/"
      ]
    },
    {
      "description": "tmux-powerline pinned by commit; its default branch is main",
      "customType": "regex",
      "matchStrings": [
        "url = \"https://github\\.com/(?<depName>erikw/tmux-powerline)/archive/(?<currentDigest>[0-9a-f]{40})\\.tar\\.gz\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}",
      "currentValueTemplate": "main",
      "versioningTemplate": "git",
      "managerFilePatterns": [
        "/^home/\\.chezmoiexternal\\.toml$/"
      ]
    },
    {
      "description": "Mise tool pins in the chezmoi template (the file is a template, so Renovate's mise manager cannot parse it)",
      "customType": "regex",
      "matchStrings": [
        "awscli = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "aws/aws-cli",
      "datasourceTemplate": "github-tags",
      "managerFilePatterns": [
        "/^home/dot_mise\\.toml\\.tmpl$/"
      ]
    },
    {
      "customType": "regex",
      "matchStrings": [
        "python = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "python-version",
      "managerFilePatterns": [
        "/^home/dot_mise\\.toml\\.tmpl$/"
      ]
    },
    {
      "customType": "regex",
      "matchStrings": [
        "talosctl = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "managerFilePatterns": [
        "/^home/dot_mise\\.toml\\.tmpl$/"
      ]
    },
    {
      "description": "Parallel Code macOS app version. Renovate bumps the version only; the sha256 next to it must be updated by hand in the same PR",
      "customType": "regex",
      "managerFilePatterns": [
        "/^home/dot_mise\\.toml\\.tmpl$/"
      ],
      "matchStrings": [
        "\\[bootstrap\\.packages\\.\"macos-app:parallel-code\"\\]\\s+version = \"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "johannesjo/parallel-code",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "automerge": true,
  "packageRules": [
    {
      "matchDepNames": [
        "johannesjo/parallel-code"
      ],
      "labels": [
        "manual-sha256"
      ],
      "prBodyNotes": [
        "The sha256 for the new .dmg in `home/dot_mise.toml.tmpl` must be updated in this PR. Renovate changes only the version."
      ]
    }
  ],
  "pre-commit": {
    "enabled": true
  }
}
